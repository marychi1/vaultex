# Required for Supabase authentication (OTP sign-in and protected dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only. Local development uses the backend on port 3002;
# replace with the HTTPS staging backend origin when testing a deployment.
VAULTEX_BACKEND_URL=http://localhost:3002

# FedEx credentials are server-side only; never use a NEXT_PUBLIC_ prefix.
FEDEX_ENV=sandbox
FEDEX_API_KEY=your-fedex-sandbox-api-key
FEDEX_SECRET_KEY=your-fedex-sandbox-secret-key
FEDEX_ACCOUNT_NUMBER=your-fedex-sandbox-account-number

# Production fails closed unless all flags and the authorized Supabase user ID are configured.
FEDEX_PRODUCTION_ENABLED=false
FEDEX_PRODUCTION_LABELS_ENABLED=false
FEDEX_PRODUCTION_ALLOWED_USER_IDS=
