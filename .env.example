# Required for Supabase authentication (OTP sign-in and protected dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional integrations. Configure only when enabling these features.
# The Stripe webhook rejects all deliveries until its signing secret is set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=
NEXT_PUBLIC_GA_ID=
GA_API_SECRET=

# Optional server-side Supabase key. Never expose this with a NEXT_PUBLIC_ prefix.
# Required for server-side webhook writes; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
