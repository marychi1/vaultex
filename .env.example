# Required for Supabase authentication (OTP sign-in and protected dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# FedEx parcel shipping is sandbox-only. Keep these server-side; never use NEXT_PUBLIC_.
FEDEX_ENV=sandbox
FEDEX_API_KEY=your-fedex-sandbox-api-key
FEDEX_SECRET_KEY=your-fedex-sandbox-secret-key
FEDEX_ACCOUNT_NUMBER=your-fedex-sandbox-account-number
